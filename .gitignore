# 虚拟环境（AGENTS.md 环境规矩）
.venv/

# Python
__pycache__/
*.pyc

# 系统垃圾
.DS_Store
Thumbs.db

# agent 测试/实验区（测试任务、测试投料都进这里，绝不进用户区）
tmp/

# ── 用户内容永不入库（隐私红线，教训#19）──────────────
# projects/ 下除本 README 外的一切：任务源件、逐页材料、诊断、
# draft、vision、裁决、台账、导出——全部是用户私有内容。
# "状态皆文件"指文件在盘上可迁移，不等于进 git。
projects/*
!projects/README.md

# 用户投料区同理
inbox/*
!inbox/README.md

# 用户临时参考材料
ref/

# 盘点视图（含用户文件名清单）
projects/inventory.json

# ── 运行时锁与缓存 ──
projects/*/live_lock.json
projects/*/.confirm_ui.lock
projects/*/live_preview/
projects/*/exports/*.pptx

# 导出的成品 pptx 较大，默认不入库（交付时单独打包）
*.pptx
